#!/bin/bash
#SBATCH --job-name=qm9-sweep
#SBATCH --partition=avicenna
#SBATCH --account=avicennausers
#SBATCH --gres=gpu:1
#SBATCH --array=0-4%2
#SBATCH --time=6-00:00:00
#SBATCH --cpus-per-task=12
#SBATCH --mem=40G
#SBATCH --output=../logs/slurm/%x-%A_%a.out

set -euo pipefail

cd /ssdstore/projects/mohammad/PlatonicTransformers
mkdir -p logs/slurm logs/wandb logs/wandb_sweeps

source /ssdstore/projects/mohammad/PlatonicTransformers/.venv/bin/activate

# source /ivi/zfs/s0/original_homes/mislam/miniconda3/etc/profile.d/conda.sh
# conda activate /ivi/zfs/s0/original_homes/mislam/miniconda3/envs/lv

export PYTHONUNBUFFERED=1
export WANDB_DIR="${WANDB_DIR:-$PWD/logs/wandb}"
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-8}"
export MKL_NUM_THREADS="${MKL_NUM_THREADS:-8}"
export OPENBLAS_NUM_THREADS="${OPENBLAS_NUM_THREADS:-8}"
export NUMEXPR_MAX_THREADS="${NUMEXPR_MAX_THREADS:-8}"
export TORCHINDUCTOR_FX_GRAPH_REMOTE_CACHE=0
export TORCHINDUCTOR_AUTOTUNE_REMOTE_CACHE=0
export TORCHINDUCTOR_CACHE_ROOT="${TORCHINDUCTOR_CACHE_ROOT:-$PWD/logs/torchinductor}"

SWEEP_CONFIG="${SWEEP_CONFIG:-sweeps/qm9_regr_table.yaml}"
SWEEP_PROJECT="${SWEEP_PROJECT:-Platonic-QM9-Regr}"
SWEEP_ENTITY="${SWEEP_ENTITY:-platonic-transformers-public}"
SWEEP_AGENT_FILE="${SWEEP_AGENT_FILE:-logs/wandb_sweeps/qm9_regr_table_agent.txt}"
SWEEP_LOCK_FILE="${SWEEP_LOCK_FILE:-logs/wandb_sweeps/qm9_regr_table_agent.lock}"
AGENTS_PER_GPU="${AGENTS_PER_GPU:-2}"
ENABLE_CUDA_MPS="${ENABLE_CUDA_MPS:-1}"

if [[ -z "${WANDB_API_KEY:-}" ]] && ! grep -q "api.wandb.ai" "$HOME/.netrc" 2>/dev/null; then
  echo "W&B is not logged in. Run this once before sbatch: wandb login" >&2
  exit 1
fi

python - <<'PY'
import os
import sys
import torch
import torch_geometric
import flash_attn

print(f"python={sys.executable}")
print(f"CUDA_VISIBLE_DEVICES={os.getenv('CUDA_VISIBLE_DEVICES')}")
print(f"torch={torch.__version__} cuda={torch.version.cuda} cuda_devices={torch.cuda.device_count()}")
print(f"torch_geometric={torch_geometric.__version__}")
print(f"flash_attn={flash_attn.__version__} OK")
PY

if [[ "$ENABLE_CUDA_MPS" == "1" ]]; then
  if command -v nvidia-cuda-mps-control >/dev/null 2>&1; then
    export CUDA_MPS_PIPE_DIRECTORY="${CUDA_MPS_PIPE_DIRECTORY:-/tmp/nvidia-mps-${SLURM_JOB_ID:-manual}-${SLURM_ARRAY_TASK_ID:-0}}"
    export CUDA_MPS_LOG_DIRECTORY="${CUDA_MPS_LOG_DIRECTORY:-$PWD/logs/mps/${SLURM_JOB_ID:-manual}_${SLURM_ARRAY_TASK_ID:-0}}"
    mkdir -p "$CUDA_MPS_PIPE_DIRECTORY" "$CUDA_MPS_LOG_DIRECTORY"
    nvidia-cuda-mps-control -d
    trap 'echo quit | nvidia-cuda-mps-control >/dev/null 2>&1 || true; rm -rf "$CUDA_MPS_PIPE_DIRECTORY"' EXIT
    echo "CUDA MPS enabled with pipe dir: $CUDA_MPS_PIPE_DIRECTORY"
  else
    echo "Warning: ENABLE_CUDA_MPS=1 but nvidia-cuda-mps-control was not found; running without MPS." >&2
  fi
fi

if [[ -n "${WANDB_SWEEP_AGENT:-}" ]]; then
  SWEEP_AGENT="$WANDB_SWEEP_AGENT"
else
  (
    flock 200
    if [[ ! -s "$SWEEP_AGENT_FILE" ]]; then
      echo "Creating W&B sweep from $SWEEP_CONFIG"
      sweep_output="$(
        wandb sweep \
          --project "$SWEEP_PROJECT" \
          --entity "$SWEEP_ENTITY" \
          "$SWEEP_CONFIG" 2>&1 | tee "logs/wandb_sweeps/create_qm9_${SLURM_JOB_ID:-manual}.log"
      )"
      sweep_agent="$(printf '%s\n' "$sweep_output" | awk '/wandb agent / {print $NF}' | tail -n 1)"
      if [[ -z "$sweep_agent" ]]; then
        sweep_id="$(printf '%s\n' "$sweep_output" | awk -F': ' '/Created sweep with ID/ {print $NF}' | tail -n 1)"
        sweep_agent="${SWEEP_ENTITY}/${SWEEP_PROJECT}/${sweep_id}"
      fi
      if [[ -z "$sweep_agent" ]]; then
        echo "Could not parse W&B sweep agent path from wandb sweep output" >&2
        exit 1
      fi
      printf '%s\n' "$sweep_agent" > "$SWEEP_AGENT_FILE"
    fi
  ) 200>"$SWEEP_LOCK_FILE"

  SWEEP_AGENT="$(cat "$SWEEP_AGENT_FILE")"
fi

echo "Running $AGENTS_PER_GPU W&B agents on one GPU: $SWEEP_AGENT"
pids=()
for local_agent_id in $(seq 1 "$AGENTS_PER_GPU"); do
  (
    export TORCHINDUCTOR_CACHE_DIR="$TORCHINDUCTOR_CACHE_ROOT/${SLURM_JOB_ID:-manual}_${SLURM_ARRAY_TASK_ID:-0}_agent_${local_agent_id}"
    export TRITON_CACHE_DIR="$TORCHINDUCTOR_CACHE_DIR/triton"
    mkdir -p "$TORCHINDUCTOR_CACHE_DIR" "$TRITON_CACHE_DIR"
    echo "TorchInductor cache for local agent ${local_agent_id}: $TORCHINDUCTOR_CACHE_DIR"
    echo "Starting local agent ${local_agent_id}/${AGENTS_PER_GPU}"
    wandb agent --count 1 "$SWEEP_AGENT"
  ) &
  pids+=("$!")
done

exit_code=0
for pid in "${pids[@]}"; do
  if ! wait "$pid"; then
    exit_code=1
  fi
done

exit "$exit_code"
